// Sistema de Gestão de Obras — AJA Grupo Empresarial
// Ver docs/requisitos.md e docs/escopo-e-orcamento.md antes de alterar.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Autenticação e pessoas
// ============================================================

enum Perfil {
  ADMINISTRADOR
  GESTOR
  OPERACIONAL
  VISUALIZADOR
}

model Usuario {
  id           String    @id @default(uuid())
  nome         String
  email        String    @unique
  senhaHash    String
  perfil       Perfil    @default(VISUALIZADOR)
  ativo        Boolean   @default(true)
  ultimoLogin  DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  tokensSenha   TokenSenha[]
  sessoes       Sessao[]
  obrasCriadas  Obra[]                @relation("ObraCriadaPor")
  obrasOperadas Obra[]                @relation("ObraOperador")
  documentos    Documento[]
  movimentos    TramitacaoMovimento[]
  dispensas     DocumentoDispensado[]

  @@index([ativo])
}

/// Token de recuperação de senha. Guardamos apenas o hash.
model TokenSenha {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId])
}

/// Sessões de login. Guardadas no banco, e não só num cookie assinado, para
/// que logout, desativação de usuário e troca de senha encerrem o acesso na
/// hora — um token autocontido continuaria valendo até expirar.
model Sessao {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Só o hash do token. O valor original existe apenas no cookie do
  /// navegador: vazamento do banco não vira sessão ativa.
  tokenHash String @unique

  expiraEm    DateTime
  ultimoUsoEm DateTime @default(now())
  criadoEm    DateTime @default(now())

  ip        String?
  userAgent String?

  @@index([usuarioId])
  @@index([expiraEm])
}

/// Órgão público contratante.
model Contratante {
  id       String  @id @default(uuid())
  nome     String
  cnpj     String? @unique
  esfera   Esfera?
  contato  String?
  telefone String?
  email    String?
  ativo    Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  obras Obra[]

  @@index([ativo])
}

enum Esfera {
  MUNICIPAL
  ESTADUAL
  FEDERAL
}

/// Setores por onde o processo tramita (registro de entrada/saída).
model Setor {
  id       String   @id @default(uuid())
  nome     String   @unique
  sigla    String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  entradas TramitacaoMovimento[] @relation("SetorDestino")
  saidas   TramitacaoMovimento[] @relation("SetorOrigem")
}

// ============================================================
// Obras
// ============================================================

enum StatusObra {
  PLANEJAMENTO
  EM_ANDAMENTO
  PARALISADA
  FINALIZADA
  CANCELADA
}

/// Farol de status — calculado pelo motor de regras (requisitos.md 1.3).
///
/// Não é coluna de `Obra` de propósito: o farol depende do tempo que passa, e
/// uma obra fica amarela sozinha à meia-noite, sem ninguém salvar nada. Cache
/// aqui só produziria luz errada. Ver docs/pontos-para-reuniao.md, ponto #1.
/// CINZA = sem dados suficientes para classificar.
enum Farol {
  VERDE
  AMARELO
  VERMELHO
  CINZA
}

/// Ritmo esperado das medições (mockup, aba Contrato). Define quando a
/// próxima medição vence e alimenta o indicador "medições atrasadas".
enum PeriodicidadeMedicao {
  MENSAL
  QUINZENAL
  SEMANAL
  PERSONALIZADA
}

model Obra {
  id             String  @id @default(uuid())
  codigo         String  @unique // identificador interno
  objeto         String // descrição da obra
  numeroContrato String
  numeroProcesso String? // protocolo no órgão

  contratanteId String
  contratante   Contratante @relation(fields: [contratanteId], references: [id])

  /// Operador que assumiu a obra — atribuição momentânea, feita pelo próprio
  /// usuário na aba Resumo, não no cadastro do contrato (requisitos.md 1.2).
  ///
  /// São 15 a 20 contratos para três pessoas: quem está disponível assume, e o
  /// nome fica como o último que mexeu depois de liberada. Não é responsável
  /// fixo pela obra nem fila de tarefas — é registro de quem cuidou por
  /// último. Aponta para `Usuario` porque quem assume é quem está logado.
  operadorId         String?
  operador           Usuario?  @relation("ObraOperador", fields: [operadorId], references: [id])
  /// Quando a atribuição atual começou. Nulo = ninguém assumiu agora, mesmo
  /// que `operadorId` ainda guarde o último que mexeu.
  operadorAssumidoEm DateTime?
  operadorLiberadoEm DateTime?
  /// Justificativa em texto livre — "aguardando foto", "aguardando relatório".
  operadorObservacao String?

  /// Valor original do contrato.
  valorContratado Decimal @db.Decimal(15, 2)
  /// Cache da soma do impacto das rerratificações aprovadas (pode ser
  /// negativo). Fonte da verdade é modules/rerratificacoes/calculos.ts, que
  /// reescreve a coluna a cada aprovação — ao contrário do farol, que não é
  /// coluna nenhuma porque envelheceria sozinho com a passagem do tempo.
  valorAditivado  Decimal @default(0) @db.Decimal(15, 2)

  dataAssinatura      DateTime?
  dataOrdemInicio     DateTime?
  prazoDias           Int?
  /// Término do contrato assinado. NÃO muda quando uma rerratificação
  /// prorroga a obra — o prazo aprovado entra em `prazoAditivadoDias` e o
  /// término que vale hoje é derivado dos dois (modules/obras/prazo.ts).
  dataPrevistaTermino DateTime?
  /// Cache da soma do prazo adicional das rerratificações APROVADAS, em dias.
  /// Mesmo papel de `valorAditivado`: a regra mora em
  /// modules/rerratificacoes/calculos.ts e a coluna é reescrita a cada
  /// alteração de rerratificação.
  prazoAditivadoDias  Int       @default(0)
  /// Data em que a obra terminou de fato, preenchida à mão no fim. Não é o
  /// término prorrogado — esse é derivado, ver `prazoAditivadoDias`.
  dataTerminoReal     DateTime?

  status StatusObra @default(PLANEJAMENTO)

  periodicidadeMedicao PeriodicidadeMedicao @default(MENSAL)
  /// Intervalo em dias — só usado quando a periodicidade é PERSONALIZADA.
  intervaloMedicaoDias Int?

  observacoes String?

  criadoPorId  String?
  criadoPor    Usuario? @relation("ObraCriadaPor", fields: [criadoPorId], references: [id])
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  medicoes        Medicao[]
  etapas          EtapaObra[]
  rerratificacoes Rerratificacao[]
  suspensoes      SuspensaoPrazo[]
  documentos      Documento[]
  dispensas       DocumentoDispensado[]

  @@index([status])
  @@index([contratanteId])
  @@index([operadorId])
  @@index([dataPrevistaTermino])
}

/// Suspensão do prazo contratual — pedido do Junior pela Fernanda em
/// 24/09/2026: *"enquanto ela estiver suspensa tudo para, e depois volta a
/// contar da data final da suspensão"*. Tudo é o prazo da obra e o ciclo das
/// medições. Uma obra pode ter mais de uma, sem sobreposição.
///
/// Nada disto vira coluna cache na obra, ao contrário do prazo aditivado:
/// enquanto `dataFim` está em branco a suspensão cresce um dia por dia, e uma
/// coluna envelheceria à meia-noite. A conta mora em
/// modules/obras/suspensao.ts e é feita na leitura.
model SuspensaoPrazo {
  id     String @id @default(uuid())
  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)

  /// O prazo para de contar neste dia.
  dataInicio  DateTime
  /// O prazo volta a contar neste dia. Em branco = a obra continua suspensa.
  dataFim     DateTime?
  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([obraId, dataInicio])
}

// ============================================================
// Medições e financeiro
// ============================================================

enum StatusMedicao {
  RASCUNHO
  PROTOCOLADA
  APROVADA
  PAGA
  REJEITADA
}

/// Percentuais agregados (% medido, saldo a medir) NÃO são colunas:
/// derivam da soma das medições sobre valorContratado + valorAditivado.
/// Ver modules/medicoes/calculos.ts.
model Medicao {
  id     String @id @default(uuid())
  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)

  numero        Int // 1ª, 2ª medição...
  competencia   DateTime // mês de referência
  periodoInicio DateTime?
  periodoFim    DateTime?
  /// Data do boletim de medição — o "DATA DA MEDIÇÃO" do mockup. Distinta da
  /// competência (mês) e do protocolo (quando entrou no órgão).
  dataMedicao   DateTime?

  valorMedido         Decimal  @db.Decimal(15, 2)
  /// Avanço físico acumulado, informado pelo usuário até 09/09/2026, quando o
  /// acompanhamento físico saiu do sistema (requisitos.md 1.4). Nenhuma tela
  /// escreve nem lê esta coluna: ela sobrevive só para não apagar o histórico
  /// das medições já lançadas. Ver etapa 13 e ponto #5.
  percentualExecutado Decimal? @db.Decimal(5, 2)

  protocolo     String?
  dataProtocolo DateTime?

  notaFiscalNumero String?
  notaFiscalData   DateTime?
  notaFiscalValor  Decimal?  @db.Decimal(15, 2)
  issAliquota      Decimal?  @db.Decimal(5, 2)
  issValor         Decimal?  @db.Decimal(15, 2)

  /// Quem assinou o boletim, digitado na própria medição.
  ///
  /// Era uma FK para `Responsavel`, um cadastro de equipe à parte dos
  /// usuários do sistema. A Fernanda pediu a retirada do cadastro em
  /// 21/09/2026 — "nas medições pode deixar só pra colocar o nome do
  /// responsável pela medição mesmo": são poucas pessoas, sempre as mesmas, e
  /// manter cadastro para isso é uma tela a mais para ganhar nada.
  responsavelNome String?

  status        StatusMedicao @default(RASCUNHO)
  dataPagamento DateTime?
  observacoes   String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  documentos Documento[]
  movimentos TramitacaoMovimento[]
  dispensas  DocumentoDispensado[]

  @@unique([obraId, numero])
  @@index([obraId, competencia])
  @@index([status])
}

// ============================================================
// Tramitação — fluxo FIXO (requisitos.md 1.5)
// ============================================================

/// Sequência fixa e não configurável. A ordem canônica vive em
/// modules/tramitacao/fluxo.ts — não reordenar sem alinhar com o cliente.
enum TipoEtapa {
  BUSCA_LICITACAO
  HABILITACAO_HOMOLOGACAO
  ASSINATURA_CONTRATO
  GARANTIA
  ORDEM_INICIO
  EXECUCAO_OBRA
  MEDICOES
  RERRATIFICACAO
  FINALIZACAO
  ACEITE
  ATESTADO
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  NAO_SE_APLICA
}

/// Instância da etapa por obra. As 11 são criadas junto com a obra.
model EtapaObra {
  id     String @id @default(uuid())
  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)

  tipo  TipoEtapa
  ordem Int // espelha a sequência fixa

  status        StatusEtapa @default(PENDENTE)
  dataInicio    DateTime?
  dataConclusao DateTime?

  /// Soma dos dias dos movimentos. Recalculado, não digitado.
  diasPermanencia Int?

  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  movimentos TramitacaoMovimento[]
  documentos Documento[]

  @@unique([obraId, tipo])
  @@index([obraId, ordem])
  @@index([status])
}

/// Entrada/saída por setor — base do cálculo de tempo de permanência.
model TramitacaoMovimento {
  id          String    @id @default(uuid())
  etapaObraId String
  etapaObra   EtapaObra @relation(fields: [etapaObraId], references: [id], onDelete: Cascade)

  setorOrigemId  String?
  setorOrigem    Setor?  @relation("SetorOrigem", fields: [setorOrigemId], references: [id])
  setorDestinoId String
  setorDestino   Setor   @relation("SetorDestino", fields: [setorDestinoId], references: [id])

  /// Medição a que este movimento pertence, quando a etapa é MEDICOES.
  /// No mockup cada medição tem protocolo próprio e caminha sozinha pelos
  /// setores; sem esta coluna, os movimentos de todas as medições da obra
  /// cairiam na mesma etapa e "setor atual da medição 5" seria impossível.
  medicaoId String?
  medicao   Medicao? @relation(fields: [medicaoId], references: [id], onDelete: Cascade)

  dataEntrada     DateTime
  dataSaida       DateTime?
  /// Preenchido ao registrar a saída.
  diasPermanencia Int?

  registradoPorId String?
  registradoPor   Usuario? @relation(fields: [registradoPorId], references: [id])
  observacoes     String?
  criadoEm        DateTime @default(now())

  documentos Documento[]

  @@index([etapaObraId, dataEntrada])
  @@index([medicaoId, dataEntrada])
  @@index([dataSaida]) // dataSaida IS NULL => processo parado
  @@index([setorDestinoId])
}

// ============================================================
// Rerratificações (requisitos.md 1.7 — só o agregado)
// ============================================================

enum StatusRerratificacao {
  EM_ELABORACAO
  PROTOCOLADA
  APROVADA
  REJEITADA
}

/// Sem detalhamento item a item por decisão de escopo: isso já consta
/// na planilha apresentada ao órgão, que fica anexada como Documento.
model Rerratificacao {
  id     String @id @default(uuid())
  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)

  numero    Int
  data      DateTime?
  protocolo String?

  /// "Ajuste de quantitativos e serviços" — a coluna Descrição do mockup.
  descricao       String?
  /// Quantos itens a planilha alterou. É contagem, não detalhamento: o
  /// item a item fica no Excel apresentado ao órgão (requisitos.md 1.7).
  quantidadeItens Int?

  /// Impacto agregado.
  percentualAlcancado Decimal @db.Decimal(5, 2)
  valorImpactado      Decimal @db.Decimal(15, 2)
  prazoAdicionalDias  Int?

  status      StatusRerratificacao @default(EM_ELABORACAO)
  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  documentos Documento[]

  @@unique([obraId, numero])
  @@index([status])
}

// ============================================================
// Gestão documental
// ============================================================

/// Vocabulário do cliente. Os dezessete primeiros são a **lista de documentos
/// do contrato**, ditada pela Fernanda em 21/09/2026 na ordem em que o
/// processo acontece; depois vêm os documentos da medição (17/09/2026) e o
/// vocabulário das outras telas — tramitação, rerratificação e acervo geral.
///
/// Três valores foram **renomeados**, e não acrescentados, porque o cliente
/// nomeia hoje o mesmo papel de antes: `GARANTIA` virou `APOLICE_SEGURO`,
/// `RERRATIFICACAO` virou `TERMO_ADITIVO` e `ACEITE` virou
/// `RECEBIMENTO_PROVISORIO`. Rename preserva o que já foi anexado; acrescentar
/// deixaria dois nomes para a mesma coisa no seletor.
enum TipoDocumento {
  // A lista do contrato — 21/09/2026, nesta ordem.
  TERMO_ADJUDICACAO
  TERMO_HOMOLOGACAO
  EMPENHO
  CONTRATO
  PUBLICACAO_EXTRATO_CONTRATO
  APOLICE_SEGURO
  PUBLICACAO_COMISSAO_FISCALIZACAO
  ORDEM_INICIO
  ART_RRT
  CNO
  MEDICAO
  TERMO_ADITIVO
  APOSTILAMENTO
  RECEBIMENTO_PROVISORIO
  RECEBIMENTO_DEFINITIVO
  LICENCA
  OUTRO

  // Os documentos necessários da medição — 17/09/2026.
  MEMORIA_CALCULO
  CRONOGRAMA
  RELATORIO_FOTOGRAFICO
  DIARIO_OBRA
  NOTA_FISCAL

  // Vocabulário das outras telas. Fora da lista do contrato, continuam
  // anexáveis onde fazem sentido — e onde já existirem, seguem aparecendo.
  PROTOCOLO
  ISS
  DESPACHO
  PARECER
  AUTORIZACAO
  EXIGENCIA
  COMPROVANTE
  ATESTADO
  EDITAL
  PROPOSTA
  FOTO
  PLANILHA
}

/// Origem rastreável via FKs explícitas: exatamente uma preenchida.
/// A restrição é garantida por CHECK constraint (migration manual),
/// que o Prisma Schema não consegue expressar.
model Documento {
  id              String  @id @default(uuid())
  nomeOriginal    String
  nomeArmazenado  String  @unique // uuid.ext no disco
  caminhoRelativo String // relativo a storage/
  mimeType        String
  extensao        String
  tamanhoBytes    BigInt
  hashSha256      String?

  tipo      TipoDocumento @default(OUTRO)
  descricao String?

  obraId           String?
  obra             Obra?                @relation(fields: [obraId], references: [id], onDelete: Cascade)
  medicaoId        String?
  medicao          Medicao?             @relation(fields: [medicaoId], references: [id], onDelete: Cascade)
  etapaObraId      String?
  etapaObra        EtapaObra?           @relation(fields: [etapaObraId], references: [id], onDelete: Cascade)
  /// Passagem por um setor específico. No mockup cada passo do fluxo tem seus
  /// próprios anexos ("Documentos da etapa": despacho, parecer, checklist), e
  /// a central de documentos mostra em que setor o arquivo entrou.
  movimentoId      String?
  movimento        TramitacaoMovimento? @relation(fields: [movimentoId], references: [id], onDelete: Cascade)
  rerratificacaoId String?
  rerratificacao   Rerratificacao?      @relation(fields: [rerratificacaoId], references: [id], onDelete: Cascade)

  enviadoPorId String?
  enviadoPor   Usuario? @relation(fields: [enviadoPorId], references: [id])

  criadoEm   DateTime  @default(now())
  /// Soft delete: o registro permanece para a trilha de auditoria.
  excluidoEm DateTime?

  @@index([tipo])
  @@index([obraId])
  @@index([medicaoId])
  @@index([etapaObraId])
  @@index([movimentoId])
  @@index([rerratificacaoId])
  @@index([nomeOriginal])
  @@index([excluidoEm])
  @@index([hashSha256])
}

/// Tipo de documento que este contrato — ou esta medição — não precisa
/// entregar (requisitos.md 1.6).
///
/// A aba Documentos deixou de listar só o que foi enviado: ela lista o que se
/// **espera**, em vermelho o que falta. Sem uma forma de dizer "aqui não se
/// aplica", uma obra sem garantia carregaria uma linha vermelha para sempre e
/// a lista perderia o sentido — vermelho que nunca apaga vira decoração.
///
/// A dispensa é do par (obra, tipo) ou (medição, tipo), nunca do tipo em si:
/// o mesmo contrato dispensa ISS e o vizinho exige.
///
/// `obraId` está sempre preenchido, inclusive na dispensa de medição, para a
/// exclusão da obra levar tudo em cascata e para a consulta da aba não
/// precisar de `join`. A unicidade é garantida por **dois índices parciais**
/// criados na migration — `medicaoId IS NULL` e `medicaoId IS NOT NULL` —,
/// que o Prisma Schema não consegue expressar: um `@@unique` comum deixaria
/// passar dispensas repetidas, porque no Postgres dois NULL não são iguais.
model DocumentoDispensado {
  id String @id @default(uuid())

  obraId String
  obra   Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)

  /// Nulo = dispensa do contrato. Preenchido = dispensa daquela medição.
  medicaoId String?
  medicao   Medicao? @relation(fields: [medicaoId], references: [id], onDelete: Cascade)

  tipo TipoDocumento

  /// Por que não se aplica — texto livre, opcional.
  motivo String?

  marcadoPorId String?
  marcadoPor   Usuario? @relation(fields: [marcadoPorId], references: [id])
  criadoEm     DateTime @default(now())

  @@index([obraId])
  @@index([medicaoId])
}

// ============================================================
// Auditoria — append-only (requisitos.md 1.8)
// ============================================================

enum AcaoAuditoria {
  CRIAR
  ATUALIZAR
  EXCLUIR
  LOGIN
  LOGOUT
  UPLOAD
  DOWNLOAD
  EXPORTAR
  TRAMITAR
}

/// Nunca sofre update ou delete. Sem @updatedAt por isso.
model Auditoria {
  id String @id @default(uuid())

  /// IDs guardados SEM foreign key, de propósito: a trilha é append-only e
  /// uma FK com onDelete geraria UPDATE/DELETE na tabela, que o trigger
  /// `auditoria_bloqueia_update_delete` proíbe. O log sobrevive à exclusão
  /// da entidade que ele descreve — que é o ponto de existir.
  usuarioId   String?
  /// Snapshot do nome: sobrevive à exclusão/renomeação do usuário.
  usuarioNome String

  acao       AcaoAuditoria
  entidade   String // "Obra", "Medicao", ...
  entidadeId String?

  /// Atalho para a aba "histórico da obra". Sem FK, pelo motivo acima.
  obraId String?

  descricao   String
  dadosAntes  Json?
  dadosDepois Json?
  ip          String?

  criadoEm DateTime @default(now())

  @@index([obraId, criadoEm])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
  @@index([usuarioId])
}

// ============================================================
// Armazenamento de arquivos em banco (driver alternativo)
// ============================================================

/// Bytes dos documentos quando `STORAGE_DRIVER=db`.
///
/// Existe para o deploy de demonstração em plataforma serverless, onde o
/// disco é efêmero e o arquivo enviado some entre uma requisição e outra. A
/// instalação real é on-premise e usa `STORAGE_DRIVER=disco`, onde esta
/// tabela fica vazia.
///
/// A chave é o mesmo `caminhoRelativo` gravado em `Documento` — assim os dois
/// drivers têm exatamente a mesma semântica (caminho -> bytes) e nenhum código
/// de rota precisa saber qual está ativo.
model ArquivoBlob {
  caminhoRelativo String   @id
  conteudo        Bytes
  criadoEm        DateTime @default(now())
}
